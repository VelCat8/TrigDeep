local function IsTracked(name)
    return KnownEnemies[name] or KnownTeammates[name] or ManualEnemies[name] or ManualTeammates[name]
end

local function IsStandardTeammate(player)
    if not player then return false end
    if not LocalPlayer.Team then return false end
    if player.Team == LocalPlayer.Team then return true end
    return false
end

local function IsIgnored(playerName)
    if not IgnoreListEnabled then return false end
    for _, name in ipairs(IgnoreList) do
        if name:lower() == playerName:lower() then
            return true
        end
    end
    return false
end

local function IsIgnoredAsTeammate(playerName)
    if not IgnoreListEnabled then return false end
    for _, name in ipairs(IgnoreList) do
        if name:lower() == playerName:lower() then
            return true
        end
    end
    return false
end

local function IsVisibleForAdaptive(targetPart)
    if not Settings.AdaptiveWallCheck then return true end
    if not targetPart or not LocalPlayer.Character then return false end
    
    local origin = LocalPlayer.Character:FindFirstChild("Head")
    if not origin then 
        origin = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not origin then return false end
    end
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    
    local direction = (targetPart.Position - origin.Position)
    local distance = direction.Magnitude
    if distance <= 0 then return false end
    
    local result = Workspace:Raycast(origin.Position, direction.Unit * distance, params)
    if not result then return true end
    
    local hit = result.Instance
    if hit then
        local hitPlayer = Players:GetPlayerFromCharacter(hit.Parent)
        if hitPlayer then return true end
        local targetChar = targetPart.Parent
        if targetChar and hit:IsDescendantOf(targetChar) then return true end
    end
    return false
end

local function IsAlive(char)
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end
    if humanoid.Health <= 0 then return false end
    return true
end

local function IsVisible(part)
    if not part or not LocalPlayer.Character then return false end
    local origin = LocalPlayer.Character:FindFirstChild("Head")
    if not origin then return false end
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    
    local result = Workspace:Raycast(origin.Position, (part.Position - origin.Position).Unit * (origin.Position - part.Position).Magnitude, params)
    if not result then return true end
    
    local hit = result.Instance
    if hit then
        local player = Players:GetPlayerFromCharacter(hit.Parent)
        if player then return true end
    end
    return false
end

local function IsWithinDistance(hrp)
    if not LocalPlayer.Character then return false end
    local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false end
    local dist = (myHrp.Position - hrp.Position).Magnitude
    return dist <= Settings.MaxAimDistance
end

