-- === TEAMCHECK ===
-- =====================================================
local function IsTeammate(player)
    if not Settings.TeamCheck then return false end
    if not player then return false end
    
    if IsIgnoredAsTeammate(player.Name) then return true end
    if ManualTeammates[player.Name] then return true end
    if ManualEnemies[player.Name] then return false end
    if IsStandardTeammate(player) then return true end
    if Settings.AdaptiveTeamCheck and KnownTeammates[player.Name] then return true end
    
    return false
end

local function CanAttack(player)
    if player == LocalPlayer then return false end
    if IsIgnoredAsTeammate(player.Name) then return false end
    if IsIgnored(player.Name) then return false end
    if ManualEnemies[player.Name] then return true end
    if ManualTeammates[player.Name] then return false end
    if IsStandardTeammate(player) then return false end
    
    if Settings.AdaptiveTeamCheck and not IsTracked(player.Name) then
        return true
    end
    
    if IsTeammate(player) then return false end
    return true
end

