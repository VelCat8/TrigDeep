UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not ScriptRunning then return end
    if not input.KeyCode then return end
    
    local key = input.KeyCode
    
    if key == Enum.KeyCode.F1 then 
        ToggleTrigger()
    elseif key == Enum.KeyCode.F2 then 
        ToggleESP()
    elseif key == Enum.KeyCode.F3 then 
        ToggleAim()
    elseif key == Enum.KeyCode.F4 then 
        ToggleIgnoreList()
    elseif key == Enum.KeyCode.F5 then 
        ToggleFly()
    elseif key == Enum.KeyCode.F6 then 
        ToggleWall()
    elseif key == Enum.KeyCode.Insert then 
        ToggleSettings()
    elseif key == Enum.KeyCode.Delete then 
        DeleteScript()
    end
end)

local function OnAction(actionName, inputState, inputObject)
    if inputState ~= Enum.UserInputState.Begin then return end
    if not ScriptRunning then return end
    
    if actionName == "TriggerBot" then ToggleTrigger()
    elseif actionName == "ESP" then ToggleESP()
    elseif actionName == "AimAssist" then ToggleAim()
    elseif actionName == "IgnoreList" then ToggleIgnoreList()
    elseif actionName == "Fly" then ToggleFly()
    elseif actionName == "WallCheck" then ToggleWall()
    elseif actionName == "Settings" then ToggleSettings()
    elseif actionName == "Delete" then DeleteScript()
    end
end

ContextActionService:BindAction("TriggerBot", OnAction, false, Enum.KeyCode.F1)
ContextActionService:BindAction("ESP", OnAction, false, Enum.KeyCode.F2)
ContextActionService:BindAction("AimAssist", OnAction, false, Enum.KeyCode.F3)
ContextActionService:BindAction("IgnoreList", OnAction, false, Enum.KeyCode.F4)
ContextActionService:BindAction("Fly", OnAction, false, Enum.KeyCode.F5)
ContextActionService:BindAction("WallCheck", OnAction, false, Enum.KeyCode.F6)
ContextActionService:BindAction("Settings", OnAction, false, Enum.KeyCode.Insert)
ContextActionService:BindAction("Delete", OnAction, false, Enum.KeyCode.Delete)

