UserInputService.InputBegan:Connect(function(input, gameProcessed)
    if gameProcessed then return end
    if not ScriptRunning then return end
    if not input.KeyCode then return end
    
    if input.KeyCode == Enum.KeyCode.F1 then ToggleTrigger()
    elseif input.KeyCode == Enum.KeyCode.F2 then ToggleESP()
    elseif input.KeyCode == Enum.KeyCode.F3 then ToggleIgnoreList()
    elseif input.KeyCode == Enum.KeyCode.F4 then ToggleFly()
    elseif input.KeyCode == Enum.KeyCode.F5 then ToggleAim()
    elseif input.KeyCode == Enum.KeyCode.F6 then ToggleWall()
    elseif input.KeyCode == Enum.KeyCode.F10 then
        if PlayerPickerPanel then PlayerPickerPanel.Toggle() end
    elseif input.KeyCode == Enum.KeyCode.Insert then ToggleSettings()
    elseif input.KeyCode == Enum.KeyCode.Delete then DeleteScript()
    end
end)

local function OnAction(actionName, inputState)
    if inputState ~= Enum.UserInputState.Begin then return end
    if not ScriptRunning then return end
    if actionName == "TriggerBot" then ToggleTrigger()
    elseif actionName == "ESP" then ToggleESP()
    elseif actionName == "IgnoreList" then ToggleIgnoreList()
    elseif actionName == "Fly" then ToggleFly()
    elseif actionName == "AimAssist" then ToggleAim()
    elseif actionName == "WallCheck" then ToggleWall()
    elseif actionName == "PlayerPicker" then
        if PlayerPickerPanel then PlayerPickerPanel.Toggle() end
    elseif actionName == "Settings" then ToggleSettings()
    elseif actionName == "Delete" then DeleteScript()
    end
end

