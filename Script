    print("[XENO] TriggerBot:", Settings.TriggerBot and "ON" or "OFF")
end

local function ToggleWall()
    if not ScriptRunning then return end
    Settings.WallCheck = not Settings.WallCheck
    if GUI and GUI.Update then GUI.Update() end
    print("[XENO] WallCheck:", Settings.WallCheck and "ON" or "OFF")
end

local function ToggleAim()
    if not ScriptRunning then return end
    Settings.AimAssist = not Settings.AimAssist
    if GUI and GUI.Update then GUI.Update() end
    print("[XENO] AimAssist:", Settings.AimAssist and "ON" or "OFF")
end

local function ToggleIgnoreList()
    if not ScriptRunning then return end
    IgnoreListEnabled = not IgnoreListEnabled
    if GUI and GUI.Update then GUI.Update() end
    if ESPEnabled then CreateESP() end
    print("[XENO] Игнор-лист:", IgnoreListEnabled and "ВКЛЮЧЕН" or "ВЫКЛЮЧЕН")
end

local function RestartScript()
    print("[XENO] ===== ПЕРЕЗАПУСК =====")
    
    if FlyEnabled then StopFly() end
    if ESPEnabled then
        ESPEnabled = false
        if ESPConnection then
            ESPConnection:Disconnect()
            ESPConnection = nil
        end
        ClearESP()
    end
    
    local savedSettings = {
        TriggerBot = Settings.TriggerBot,
        WallCheck = Settings.WallCheck,
        AimAssist = Settings.AimAssist,
        Smoothness = Settings.Smoothness,
        FOV = Settings.FOV,
        TriggerRadius = Settings.TriggerRadius,
        ShotDelay = Settings.ShotDelay,
    }
    local savedIgnoreList = {}
    for _, name in ipairs(IgnoreList) do
        table.insert(savedIgnoreList, name)
    end
    local savedIgnoreEnabled = IgnoreListEnabled
    
    StopLoop()
    if GUI and GUI.CloseSettings then GUI.CloseSettings() end
    if GUI and GUI.Destroy then GUI.Destroy() end
    GUI = CreateGUI()
    
    Settings.TriggerBot = savedSettings.TriggerBot
    Settings.WallCheck = savedSettings.WallCheck
    Settings.AimAssist = savedSettings.AimAssist
    Settings.Smoothness = savedSettings.Smoothness
    Settings.FOV = savedSettings.FOV
    Settings.TriggerRadius = savedSettings.TriggerRadius
    Settings.ShotDelay = savedSettings.ShotDelay
    
    IgnoreList = savedIgnoreList
    IgnoreListEnabled = savedIgnoreEnabled
    
    if GUI and GUI.Update then GUI.Update() end
    StartLoop()
    
    print("[XENO] ✅ Перезапуск завершен!")
end

local function DeleteScript()
    print("[XENO] Скрипт удален")
    ScriptRunning = false
    
    if FlyEnabled then StopFly() end
    if ESPEnabled then
        if ESPConnection then
            ESPConnection:Disconnect()
            ESPConnection = nil
        end
        ClearESP()
    end
    
    StopLoop()
    if GUI and GUI.Destroy then GUI.Destroy() end
end

