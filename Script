    local function Refresh()
        for _, child in ipairs(TeamScroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, child in ipairs(EnemyScroll:GetChildren()) do
            if child:IsA("TextButton") then child:Destroy() end
        end
        for _, child in ipairs(AllScroll:GetChildren()) do
            if child:IsA("Frame") then child:Destroy() end
        end
        
        local teamCount = 0
        local enemyCount = 0
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if ManualTeammates[player.Name] then
                CreateTeamCard(player, TeamScroll, true)
                teamCount = teamCount + 1
            end
        end
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            if ManualEnemies[player.Name] then
                CreateTeamCard(player, EnemyScroll, false)
                enemyCount = enemyCount + 1
            end
        end
        
        for _, player in ipairs(Players:GetPlayers()) do
            if player == LocalPlayer then continue end
            CreateAllCard(player, AllScroll)
        end
        
        TeamTitle.Text = "🛡️ TEAMMATES (" .. teamCount .. ")"
        EnemyTitle.Text = "❌ ENEMIES (" .. enemyCount .. ")"
        AllTitle.Text = "👥 ALL PLAYERS (" .. (#Players:GetPlayers() - 1) .. ")"
        
        TeamScroll.CanvasSize = UDim2.new(0, 0, 0, teamCount * 60)
        EnemyScroll.CanvasSize = UDim2.new(0, 0, 0, enemyCount * 60)
