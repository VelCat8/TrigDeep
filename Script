        if #IgnoreList == 0 then
            ignoreListLabel.Text = "Пусто"
        else
            ignoreListLabel.Text = table.concat(IgnoreList, ", ")
        end
    end
    
    return {
        Update = function()
            statuses.trigger.Text = Settings.TriggerBot and "ВКЛ" or "ВЫКЛ"
            statuses.trigger.TextColor3 = Settings.TriggerBot and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
            
            statuses.wall.Text = Settings.WallCheck and "ВКЛ" or "ВЫКЛ"
            statuses.wall.TextColor3 = Settings.WallCheck and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
            
            statuses.aim.Text = Settings.AimAssist and "ВКЛ" or "ВЫКЛ"
            statuses.aim.TextColor3 = Settings.AimAssist and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
            
            if not IgnoreListEnabled then
                statuses.ignore.Text = "ВЫКЛ"
                statuses.ignore.TextColor3 = Color3.fromRGB(255, 0, 0)
            elseif #IgnoreList > 0 then
                statuses.ignore.Text = "ВКЛ"
                statuses.ignore.TextColor3 = Color3.fromRGB(0, 255, 0)
            else
                statuses.ignore.Text = "ВЫКЛ"
                statuses.ignore.TextColor3 = Color3.fromRGB(255, 0, 0)
            end
            
            statuses.fly.Text = FlyEnabled and "ВКЛ" or "ВЫКЛ"
            statuses.fly.TextColor3 = FlyEnabled and Color3.fromRGB(0, 255, 255) or Color3.fromRGB(255, 0, 0)
            
            statuses.esp.Text = ESPEnabled and "ВКЛ" or "ВЫКЛ"
            statuses.esp.TextColor3 = ESPEnabled and Color3.fromRGB(0, 255, 0) or Color3.fromRGB(255, 0, 0)
            
            UpdateIgnoreList()
        end,
        Destroy = function()
            screenGui:Destroy()
        end,
        ToggleSettings = function()
            if not settingsPanel then return end
            settingsPanel.Visible = not settingsPanel.Visible
            SettingsOpen = settingsPanel.Visible
            if settingsPanel.Visible then
                UpdateIgnoreList()
            end
        end,
        CloseSettings = function()
            if settingsPanel then
                settingsPanel.Visible = false
                SettingsOpen = false
            end
        end
    }
end

local GUI = CreateGUI()

-- ===== ФУНКЦИИ ДЛЯ ТРИГГЕРБОТА =====
local function IsAlive(char)
    if not char then return false end
    local humanoid = char:FindFirstChild("Humanoid")
    if not humanoid then return false end
    if humanoid.Health <= 0 then return false end
    return true
end

local function IsVisible(part)
    if not part or not LocalPlayer.Character then return false end
    
    local origin = LocalPlayer.Character:FindFirstChild("Head")
    if not origin then return false end
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    
    local result = Workspace:Raycast(origin.Position, (part.Position - origin.Position).Unit * (origin.Position - part.Position).Magnitude, params)
    
    if not result then return true end
    
    local hit = result.Instance
    if hit then
        local player = Players:GetPlayerFromCharacter(hit.Parent)
        if player then return true end
    end
    
    return false
end

local function GetTarget()
    if not LocalPlayer.Character then return nil end
    
    local center = Vector2.new(Mouse.X, Mouse.Y)
    local best = nil
    local bestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if IsIgnored(player.Name) then continue end
        
        local char = player.Character
        if not char then continue end
        if not IsAlive(char) then continue end
        
        local part = char:FindFirstChild("Head")
        if not part then
            part = char:FindFirstChild("HumanoidRootPart")
        end
        if not part then continue end
        
        local aimPos = part.Position + Vector3.new(0, 2.2, 0)
        
        local pos, onScreen = Camera:WorldToViewportPoint(aimPos)
        if not onScreen then continue end
        
        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        
        if dist > Settings.FOV then continue end
        if Settings.WallCheck and not IsVisible(part) then continue end
        
        if dist < bestDist then
            bestDist = dist
            best = {Player = player, Part = part, ScreenPos = Vector2.new(pos.X, pos.Y), Dist = dist}
        end
    end
    
    return best
end

local function DoAimAssist()
    if not Settings.TriggerBot or not Settings.AimAssist then return end
    
    local target = GetTarget()
    if not target then return end
    
    local dx = target.ScreenPos.X - Mouse.X
    local dy = target.ScreenPos.Y - Mouse.Y
    
    mousemoverel(dx * Settings.Smoothness, dy * Settings.Smoothness * 1.2)
end

local function IsOnTarget()
    if not LocalPlayer.Character then return false end
    
    local center = Vector2.new(Mouse.X, Mouse.Y)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        if IsIgnored(player.Name) then continue end
        
        local char = player.Character
        if not char then continue end
        if not IsAlive(char) then continue end
        
        local head = char:FindFirstChild("Head")
        if head then
            local aimPos = head.Position + Vector3.new(0, 2.2, 0)
            local pos, onScreen = Camera:WorldToViewportPoint(aimPos)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if dist < Settings.TriggerRadius then
                    if Settings.WallCheck and not IsVisible(head) then
                        return false
                    end
                    return true
                end
            end
        end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp then
            local aimPos = hrp.Position + Vector3.new(0, 2.2, 0)
            local pos, onScreen = Camera:WorldToViewportPoint(aimPos)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if dist < Settings.TriggerRadius + 30 then
                    if Settings.WallCheck and not IsVisible(hrp) then
                        return false
                    end
                    return true
                end
            end
        end
    end
    
    return false
end

local LastShot = 0

local function MainLoop()
    if not Settings.TriggerBot then return end
    
    DoAimAssist()
    
    if IsOnTarget() and tick() - LastShot > Settings.ShotDelay then
        pcall(function()
            mouse1click()
        end)
        LastShot = tick()
    end
end

-- ===== ЗАПУСК/ОСТАНОВКА =====
local function StartLoop()
    if MainConnection then
        MainConnection:Disconnect()
        MainConnection = nil
    end
    MainConnection = RunService.RenderStepped:Connect(function()
        pcall(MainLoop)
    end)
end

local function StopLoop()
    if MainConnection then
        MainConnection:Disconnect()
        MainConnection = nil
    end
end

