-- =====================================================
function ToggleSettings()
    if not ScriptRunning then return end
    if SettingsPanel then SettingsPanel.Toggle() end
end

function ToggleTrigger()
    if not ScriptRunning then return end
    Settings.TriggerBot = not Settings.TriggerBot
    if GUI and GUI.Update then GUI.Update() end
    Notify("🎯 TriggerBot " .. (Settings.TriggerBot and "ON" or "OFF"), Settings.TriggerBot and COLORS.Success or COLORS.Error)
end

function ToggleWall()
    if not ScriptRunning then return end
    Settings.WallCheck = not Settings.WallCheck
    if GUI and GUI.Update then GUI.Update() end
    Notify("🧱 WallCheck " .. (Settings.WallCheck and "ON" or "OFF"), Settings.WallCheck and COLORS.Success or COLORS.Error)
end

function ToggleAim()
    if not ScriptRunning then return end
    Settings.AimAssist = not Settings.AimAssist
    if GUI and GUI.Update then GUI.Update() end
    Notify("🎯 Aim Assist " .. (Settings.AimAssist and "ON" or "OFF"), Settings.AimAssist and COLORS.Success or COLORS.Error)
end

function ToggleIgnoreList()
    if not ScriptRunning then return end
    IgnoreListEnabled = not IgnoreListEnabled
    if GUI and GUI.Update then GUI.Update() end
    if ESPEnabled then CreateESP() end
    Notify("👤 Ignore List " .. (IgnoreListEnabled and "ON" or "OFF"), COLORS.AccentGlow)
end

function ToggleFly()
    if not ScriptRunning then return end
    if FlyEnabled then StopFly() else StartFly() end
    if GUI and GUI.Update then GUI.Update() end
end

function ToggleESP()
    if not ScriptRunning then return end
    ESPEnabled = not ESPEnabled
    
    if ESPEnabled then
        Notify("👁️ ESP ON", COLORS.AccentGlow)
        CreateESP()
        ESPConnection = RunService.Heartbeat:Connect(function()
            if ESPEnabled and tick() - LastESPUpdate > 2 then
                CheckNewPlayers()
                LastESPUpdate = tick()
            end
        end)
    else
        Notify("👁️ ESP OFF", COLORS.Error)
        if ESPConnection then ESPConnection:Disconnect(); ESPConnection = nil end
        ClearESP()
    end
    if GUI and GUI.Update then GUI.Update() end
end

function ResetTeams()
    KnownEnemies = {}
    KnownTeammates = {}
    PendingShots = {}
    LastCheckShot = {}
    ManualEnemies = {}
    ManualTeammates = {}
    Notify("🔄 All lists reset", COLORS.Warning)
end

function DeleteScript()
    Notify("🗑 Script deleted", COLORS.Error)
    ScriptRunning = false
    if FlyEnabled then StopFly() end
    if ESPEnabled then
        if ESPConnection then ESPConnection:Disconnect() end
        ClearESP()
    end
    StopLoop()
    if GUI then GUI.Destroy() end
    if PlayerPickerPanel then PlayerPickerPanel.Destroy() end
    if LocalPlayer.PlayerGui:FindFirstChild("SettingsPanel") then
        LocalPlayer.PlayerGui.SettingsPanel:Destroy()
    end
    if LocalPlayer.PlayerGui:FindFirstChild("Trig_Notifications") then
        LocalPlayer.PlayerGui.Trig_Notifications:Destroy()
    end
end

