local function ToggleSettings()
    if not ScriptRunning then return end
    if SettingsPanel then SettingsPanel.Toggle() end
end

local function ToggleTrigger()
    if not ScriptRunning then return end
    Settings.TriggerBot = not Settings.TriggerBot
    if GUI and GUI.Update then GUI.Update() end
    print("[XENO] TriggerBot:", Settings.TriggerBot and "ON" or "OFF")
end

local function ToggleWall()
    if not ScriptRunning then return end
    Settings.WallCheck = not Settings.WallCheck
    if GUI and GUI.Update then GUI.Update() end
    print("[XENO] WallCheck:", Settings.WallCheck and "ON" or "OFF")
end

local function ToggleAim()
    if not ScriptRunning then return end
    Settings.AimAssist = not Settings.AimAssist
    if GUI and GUI.Update then GUI.Update() end
    print("[XENO] AimAssist:", Settings.AimAssist and "ON" or "OFF")
end

local function ToggleIgnoreList()
    if not ScriptRunning then return end
    IgnoreListEnabled = not IgnoreListEnabled
    if GUI and GUI.Update then GUI.Update() end
    if ESPEnabled then CreateESP() end
    print("[XENO] Игнор-лист:", IgnoreListEnabled and "ВКЛ" or "ВЫКЛ")
end

local function ToggleFly()
    if not ScriptRunning then return end
    if FlyEnabled then StopFly() else StartFly() end
    if GUI and GUI.Update then GUI.Update() end
end

local function ToggleESP()
    if not ScriptRunning then return end
    ESPEnabled = not ESPEnabled
    
    if ESPEnabled then
        print("[XENO] 👁️ ESP ВКЛЮЧЕН")
        CreateESP()
        ESPConnection = RunService.Heartbeat:Connect(function()
            if ESPEnabled and tick() - LastESPUpdate > 2 then
                CheckNewPlayers()
                LastESPUpdate = tick()
            end
        end)
    else
        print("[XENO] 👁️ ESP ВЫКЛЮЧЕН")
        if ESPConnection then ESPConnection:Disconnect(); ESPConnection = nil end
        ClearESP()
    end
    if GUI and GUI.Update then GUI.Update() end
end

local function DeleteScript()
    print("[XENO] Скрипт удален")
    ScriptRunning = false
    if FlyEnabled then StopFly() end
    if ESPEnabled then
        if ESPConnection then ESPConnection:Disconnect() end
        ClearESP()
    end
    StopLoop()
    if GUI then GUI.Destroy() end
    if PlayerPickerPanel then PlayerPickerPanel.Destroy() end
    if LocalPlayer.PlayerGui:FindFirstChild("SettingsPanel") then
        LocalPlayer.PlayerGui.SettingsPanel:Destroy()
    end
end

