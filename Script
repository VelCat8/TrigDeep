local function ClearESP()
    for _, obj in ipairs(ESPObjects) do
        pcall(function() 
            if obj and obj.Parent then obj:Destroy() end
        end)
    end
    ESPObjects = {}
end

local function CreateESP()
    ClearESP()
    if not ESPEnabled then return end
    if not LocalPlayer.Character then return end
    
    local myPos = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myPos then return end
    myPos = myPos.Position
    
    for _, player in ipairs(Players:GetPlayers()) do
        if player == LocalPlayer then continue end
        
        local char = player.Character
        if not char then continue end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if not hrp then continue end
        
        local dist = (myPos - hrp.Position).Magnitude
        if dist > ESP_MAX_DISTANCE then continue end
        
        local humanoid = char:FindFirstChild("Humanoid")
        if not humanoid or humanoid.Health <= 0 then continue end
        
        local boxColor = COLORS.Text
        
        if IsIgnoredAsTeammate(player.Name) then
            boxColor = COLORS.Success
        elseif ManualEnemies[player.Name] or KnownEnemies[player.Name] then
            boxColor = COLORS.Error
        elseif ManualTeammates[player.Name] or KnownTeammates[player.Name] or IsStandardTeammate(player) then
            boxColor = COLORS.Success
        end
        
        local box = Instance.new("BoxHandleAdornment")
        box.Size = Vector3.new(4.5, 7, 2.5)
        box.Adornee = hrp
        box.Color3 = boxColor
        box.Transparency = 0.3
        box.ZIndex = 0
        box.AlwaysOnTop = true
        box.Parent = hrp
        table.insert(ESPObjects, box)
        
        local head = char:FindFirstChild("Head")
        local hpBar = Instance.new("BillboardGui")
        hpBar.Size = UDim2.new(0, 60, 0, 6)
        hpBar.Adornee = head or hrp
        hpBar.StudsOffset = Vector3.new(0, 4, 0)
        hpBar.AlwaysOnTop = true
        hpBar.Parent = hrp
        table.insert(ESPObjects, hpBar)
        
        local hpBg = Instance.new("Frame")
        hpBg.Size = UDim2.new(1, 0, 1, 0)
        hpBg.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
        hpBg.BackgroundTransparency = 0.3
        hpBg.BorderSizePixel = 0
        hpBg.Parent = hpBar
        Instance.new("UICorner", hpBg).CornerRadius = UDim.new(1, 0)
        
        local hpFill = Instance.new("Frame")
        hpFill.Size = UDim2.new(1, 0, 1, 0)
        hpFill.BackgroundColor3 = COLORS.Success
        hpFill.BorderSizePixel = 0
        hpFill.Parent = hpBg
        Instance.new("UICorner", hpFill).CornerRadius = UDim.new(1, 0)
        
        local function UpdateHP()
            local h = char:FindFirstChild("Humanoid")
            if h then
                local health = h.Health / h.MaxHealth
                hpFill.Size = UDim2.new(health, 0, 1, 0)
                if health > 0.6 then
                    hpFill.BackgroundColor3 = COLORS.Success
                elseif health > 0.3 then
                    hpFill.BackgroundColor3 = COLORS.Warning
                else
                    hpFill.BackgroundColor3 = COLORS.Error
                end
            end
        end
        
        task.spawn(function()
            while hpFill and hpFill.Parent and humanoid and humanoid.Parent do
                if not ESPEnabled then break end
                UpdateHP()
                task.wait(0.1)
            end
        end)
        UpdateHP()
    end
end

local function CheckNewPlayers()
    if not ESPEnabled then return end
    
    local currentPlayers = {}
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer then
            local char = player.Character
            if char and char:FindFirstChild("HumanoidRootPart") then
                local humanoid = char:FindFirstChild("Humanoid")
                if humanoid and humanoid.Health > 0 then
                    currentPlayers[player.Name] = true
                end
            end
        end
    end
    
    local existingPlayers = {}
    for _, obj in ipairs(ESPObjects) do
        if obj:IsA("BoxHandleAdornment") then
            local parent = obj.Parent
            if parent and parent:IsA("BasePart") then
                local char = parent.Parent
                if char and char:IsA("Model") then
                    local player = Players:GetPlayerFromCharacter(char)
                    if player then existingPlayers[player.Name] = true end
                end
            end
        end
    end
    
    for name in pairs(currentPlayers) do
        if not existingPlayers[name] then
            CreateESP()
            return
        end
    end
end

