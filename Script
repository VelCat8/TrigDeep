    elseif key == Enum.KeyCode.Insert then 
        ToggleSettings()
    elseif key == Enum.KeyCode.Delete then 
        DeleteScript()
    end
end)

-- ContextActionService (резервный)
local function OnAction(actionName, inputState, inputObject)
    if inputState ~= Enum.UserInputState.Begin then return end
    if not ScriptRunning then return end
    
    if actionName == "TriggerBot" then 
        ToggleTrigger()
    elseif actionName == "ESP" then 
        ToggleESP()
    elseif actionName == "AimAssist" then 
        ToggleAim()
    elseif actionName == "Fly" then 
        ToggleFly()
    elseif actionName == "IgnoreList" then 
        ToggleIgnoreList()
    elseif actionName == "WallCheck" then 
        ToggleWall()
    elseif actionName == "Settings" then 
        ToggleSettings()
    elseif actionName == "Delete" then 
        DeleteScript()
    end
end

