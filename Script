    Instance.new("UICorner", container).CornerRadius = UDim.new(1, 0)
    
    local stroke = Instance.new("UIStroke")
    stroke.Color = getState() and COLORS.Accent or COLORS.Disabled
    stroke.Thickness = 1
    stroke.Transparency = 0.3
    stroke.Parent = container
    
    local circle = Instance.new("Frame")
    circle.Name = "Circle"
    circle.Size = UDim2.new(0, 18, 0, 18)
    circle.Position = getState() and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9)
    circle.BackgroundColor3 = getState() and COLORS.Accent or COLORS.Disabled
    circle.BorderSizePixel = 0
    circle.Parent = container
    Instance.new("UICorner", circle).CornerRadius = UDim.new(1, 0)
    
    return {
        Container = container,
        Circle = circle,
        Update = function()
            local state = getState()
            TweenService:Create(container, TweenInfo.new(0.2), {
                BackgroundColor3 = state and COLORS.AccentDark or COLORS.Disabled
            }):Play()
            TweenService:Create(circle, TweenInfo.new(0.2), {
                Position = state and UDim2.new(1, -21, 0.5, -9) or UDim2.new(0, 3, 0.5, -9),
                BackgroundColor3 = state and COLORS.Accent or COLORS.Disabled
            }):Play()
            TweenService:Create(stroke, TweenInfo.new(0.2), {
                Color = state and COLORS.Accent or COLORS.Disabled
            }):Play()
        end
    }
end

