-- === ТРИГГЕРБОТ ===
-- =====================================================
local function GetTarget()
    if not LocalPlayer.Character then return nil end
    
    local center = Vector2.new(Mouse.X, Mouse.Y)
    local best = nil
    local bestDist = math.huge
    
    for _, player in ipairs(Players:GetPlayers()) do
        if not CanAttack(player) then continue end
        
        local char = player.Character
        if not char then continue end
        if not IsAlive(char) then continue end
        
        local part = char:FindFirstChild("Head")
        if not part then part = char:FindFirstChild("HumanoidRootPart") end
        if not part then continue end
        if not IsWithinDistance(part) then continue end
        
        local aimPos = part.Position + Vector3.new(0, Settings.AimOffset, 0)
        local pos, onScreen = Camera:WorldToViewportPoint(aimPos)
        if not onScreen then continue end
        
        local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
        if dist > Settings.FOV then continue end
        if Settings.WallCheck and not IsVisible(part) then continue end
        
        if dist < bestDist then
            bestDist = dist
            best = {Player = player, Part = part, ScreenPos = Vector2.new(pos.X, pos.Y), Dist = dist}
        end
    end
    return best
end

local function DoAimAssist()
    if not Settings.TriggerBot or not Settings.AimAssist then return end
    local target = GetTarget()
    if not target then return end
    
    local dx = target.ScreenPos.X - Mouse.X
    local dy = target.ScreenPos.Y - Mouse.Y
    mousemoverel(dx * Settings.Smoothness, dy * Settings.Smoothness * 1.2)
end

local function IsOnTarget()
    if not LocalPlayer.Character then return false, nil end
    local center = Vector2.new(Mouse.X, Mouse.Y)
    
    for _, player in ipairs(Players:GetPlayers()) do
        if not CanAttack(player) then continue end
        
        local char = player.Character
        if not char then continue end
        if not IsAlive(char) then continue end
        
        local head = char:FindFirstChild("Head")
        if head and IsWithinDistance(head) then
            local aimPos = head.Position + Vector3.new(0, Settings.AimOffset, 0)
            local pos, onScreen = Camera:WorldToViewportPoint(aimPos)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if dist < Settings.TriggerRadius then
                    if not (Settings.WallCheck and not IsVisible(head)) then
                        return true, player
                    end
                end
            end
        end
        
        local hrp = char:FindFirstChild("HumanoidRootPart")
        if hrp and IsWithinDistance(hrp) then
            local aimPos = hrp.Position + Vector3.new(0, Settings.AimOffset, 0)
            local pos, onScreen = Camera:WorldToViewportPoint(aimPos)
            if onScreen then
                local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
                if dist < Settings.TriggerRadius + 30 then
                    if not (Settings.WallCheck and not IsVisible(hrp)) then
                        return true, player
                    end
                end
            end
        end
    end
    return false, nil
end

local function WasAimedAtTarget(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    
    local char = targetPlayer.Character
    local center = Vector2.new(Mouse.X, Mouse.Y)
    
    local head = char:FindFirstChild("Head")
    if head and IsWithinDistance(head) then
        local aimPos = head.Position + Vector3.new(0, Settings.AimOffset, 0)
        local pos, onScreen = Camera:WorldToViewportPoint(aimPos)
        if onScreen then
            local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
            if dist < Settings.AimPrecision then return true end
        end
    end
    
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if hrp and IsWithinDistance(hrp) then
        local aimPos = hrp.Position + Vector3.new(0, Settings.AimOffset, 0)
        local pos, onScreen = Camera:WorldToViewportPoint(aimPos)
        if onScreen then
            local dist = (Vector2.new(pos.X, pos.Y) - center).Magnitude
            if dist < Settings.AimPrecision + 10 then return true end
        end
    end
    return false
end

local function WasVisibleForAdaptive(targetPlayer)
    if not targetPlayer or not targetPlayer.Character then return false end
    local char = targetPlayer.Character
    local head = char:FindFirstChild("Head")
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if head and IsVisibleForAdaptive(head) then return true end
    if hrp and IsVisibleForAdaptive(hrp) then return true end
    return false
end

local LastShot = 0

local function MainLoop()
    if not Settings.TriggerBot then return end
    DoAimAssist()
    
    local isTargeting, targetPlayer = IsOnTarget()
    if isTargeting and tick() - LastShot > Settings.ShotDelay then
        if targetPlayer then
            if IsIgnoredAsTeammate(targetPlayer.Name) then
                KnownTeammates[targetPlayer.Name] = true
            elseif ManualEnemies[targetPlayer.Name] then
                -- Ручной враг
            elseif ManualTeammates[targetPlayer.Name] then
                -- Ручной тиммейт
            elseif IsStandardTeammate(targetPlayer) then
                KnownTeammates[targetPlayer.Name] = true
                KnownEnemies[targetPlayer.Name] = nil
            elseif Settings.AdaptiveTeamCheck and not IsTracked(targetPlayer.Name) then
                if not LastCheckShot[targetPlayer.Name] or tick() - LastCheckShot[targetPlayer.Name] > Settings.CheckShotCooldown then
                    local wasAimed = WasAimedAtTarget(targetPlayer)
                    local wasVisible = WasVisibleForAdaptive(targetPlayer)
                    RegisterShot(targetPlayer.Name, wasAimed, wasVisible)
                    if wasAimed and wasVisible then
                        LastCheckShot[targetPlayer.Name] = tick()
                    end
                end
            end
        end
        
        pcall(function() mouse1click() end)
        LastShot = tick()
    end
end

local function StartLoop()
    if MainConnection then MainConnection:Disconnect(); MainConnection = nil end
    MainConnection = RunService.RenderStepped:Connect(function()
        pcall(MainLoop)
    end)
end

local function StopLoop()
    if MainConnection then MainConnection:Disconnect(); MainConnection = nil end
end

