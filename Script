-- =====================================================
-- === АДАПТИВНЫЙ TEAMCHECK ===
-- =====================================================
local KnownEnemies = {}
local KnownTeammates = {}
local PendingShots = {}
local LastHealthCache = {}
local LastCheckShot = {}

local function IsTracked(name)
    return KnownEnemies[name] or KnownTeammates[name] or ManualEnemies[name] or ManualTeammates[name]
end

local function IsStandardTeammate(player)
    if not player then return false end
    if not LocalPlayer.Team then return false end
    if player.Team == LocalPlayer.Team then return true end
    return false
end

local function IsVisibleForAdaptive(targetPart)
    if not Settings.AdaptiveWallCheck then return true end
    if not targetPart or not LocalPlayer.Character then return false end
    
    local origin = LocalPlayer.Character:FindFirstChild("Head")
    if not origin then 
        origin = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
        if not origin then return false end
    end
    
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Blacklist
    params.FilterDescendantsInstances = {LocalPlayer.Character, Camera}
    
    local direction = (targetPart.Position - origin.Position)
    local distance = direction.Magnitude
    
    if distance <= 0 then return false end
    
    local result = Workspace:Raycast(origin.Position, direction.Unit * distance, params)
    
    if not result then return true end
    
    local hit = result.Instance
    if hit then
        local hitPlayer = Players:GetPlayerFromCharacter(hit.Parent)
        if hitPlayer then return true end
        
        local targetChar = targetPart.Parent
        if targetChar and hit:IsDescendantOf(targetChar) then
            return true
        end
    end
    
    return false
end

local function RegisterShot(targetName, wasAimed, wasVisible)
    for i = #PendingShots, 1, -1 do
        if PendingShots[i].Target == targetName then
            table.remove(PendingShots, i)
        end
    end
    
    if not wasAimed then
        print("[TEAM] 🎯 Промах по " .. targetName)
        return
    end
    
    if not wasVisible then
        print("[TEAM] 🧱 " .. targetName .. " за стеной")
        return
    end
    
    if ManualEnemies[targetName] then
        print("[TEAM] ❌ " .. targetName .. " — в ручном списке ВРАГОВ")
        KnownEnemies[targetName] = true
        return
    end
    
    if ManualTeammates[targetName] then
        print("[TEAM] 🛡️ " .. targetName .. " — в ручном списке СВОИХ")
        KnownTeammates[targetName] = true
        return
    end
    
    local targetPlayer = Players:FindFirstChild(targetName)
    if IsStandardTeammate(targetPlayer) then
        print("[TEAM] 🛡️ " .. targetName .. " — стандартный тиммейт")
        KnownTeammates[targetName] = true
        KnownEnemies[targetName] = nil
        return
    end
    
    if KnownTeammates[targetName] then
        print("[TEAM] 🛡️ " .. targetName .. " уже СВОЙ")
        return
    end
    
    local hpBefore = 100
    if targetPlayer and targetPlayer.Character then
        local humanoid = targetPlayer.Character:FindFirstChild("Humanoid")
        if humanoid then
            hpBefore = humanoid.Health
        end
    end
    
    table.insert(PendingShots, {
        Target = targetName,
        Time = tick(),
        HealthBefore = hpBefore,
    })
    
    print("[TEAM] ✅ Проверка: " .. targetName)
    
    task.delay(5, function()
        for i, shot in ipairs(PendingShots) do
            if shot.Target == targetName and tick() - shot.Time >= 4.9 then
                local p = Players:FindFirstChild(targetName)
                local isEnemy = false
                local isDead = false
                local isGone = false
                local isStdTeammate = false
                local isManualTeam = false
                local isManualEnemy = false
                
                if IsStandardTeammate(p) then isStdTeammate = true end
                if ManualTeammates[targetName] then isManualTeam = true end
                if ManualEnemies[targetName] then isManualEnemy = true end
                
                if p and p.Character then
                    local humanoid = p.Character:FindFirstChild("Humanoid")
                    if humanoid then
                        local currentHP = humanoid.Health
                        
                        if currentHP <= 0 then
                            isDead = true
                            isEnemy = true
                        elseif shot.HealthBefore and currentHP < shot.HealthBefore - 0.5 then
                            isEnemy = true
                        end
                    end
                elseif p and not p.Character then
                    isDead = true
                    isEnemy = true
                elseif not p then
                    isGone = true
                end
                
                if isManualEnemy then
                    KnownEnemies[targetName] = true
                    KnownTeammates[targetName] = nil
                    print("[TEAM] ❌ " .. targetName .. " = ВРАГ (ручной список)")
                elseif isManualTeam then
                    KnownTeammates[targetName] = true
                    KnownEnemies[targetName] = nil
                    print("[TEAM] 🛡️ " .. targetName .. " = СВОЙ (ручной список)")
                elseif isStdTeammate then
                    KnownTeammates[targetName] = true
                    KnownEnemies[targetName] = nil
                    print("[TEAM] 🛡️ " .. targetName .. " = СВОЙ (стандартный тиммейт)")
                elseif isGone then
                    print("[TEAM] ⚠️ " .. targetName .. " вышел")
                elseif isEnemy then
                    KnownEnemies[targetName] = true
                    KnownTeammates[targetName] = nil
                    if isDead then
                        print("[TEAM] ❌ " .. targetName .. " = ВРАГ (убит)")
                    else
                        print("[TEAM] ❌ " .. targetName .. " = ВРАГ (урон прошёл)")
                    end
                else
                    KnownTeammates[targetName] = true
                    KnownEnemies[targetName] = nil
                    print("[TEAM] ✅ " .. targetName .. " = СВОЙ (урон не прошёл)")
                end
                
                table.remove(PendingShots, i)
                break
            end
        end
    end)
end

local function StartHealthTracking()
    task.spawn(function()
        while ScriptRunning do
            task.wait(0.05)
            
            for _, player in ipairs(Players:GetPlayers()) do
                if player == LocalPlayer then continue end
                
                local char = player.Character
                if not char then continue end
                
                local humanoid = char:FindFirstChild("Humanoid")
                if not humanoid then continue end
                
                local currentHP = humanoid.Health
                local lastHP = LastHealthCache[player.Name]
                
                if lastHP and currentHP < lastHP - 0.5 then
                    if not IsStandardTeammate(player) and not ManualTeammates[player.Name] and not ManualEnemies[player.Name] then
                        for i, shot in ipairs(PendingShots) do
                            if shot.Target == player.Name then
                                KnownEnemies[player.Name] = true
                                KnownTeammates[player.Name] = nil
                                print("[TEAM] ❌ " .. player.Name .. " = ВРАГ (урон: " .. math.floor(lastHP - currentHP) .. ")")
                                table.remove(PendingShots, i)
                                break
                            end
                        end
                    end
                end
                
                LastHealthCache[player.Name] = currentHP
            end
        end
    end)
end

-- =====================================================
-- === ПРОВЕРКА СВОИХ ===
-- =====================================================
local function IsTeammate(player)
    if not Settings.TeamCheck then return false end
    if not player then return false end
    
    if ManualTeammates[player.Name] then return true end
    if ManualEnemies[player.Name] then return false end
    if IsStandardTeammate(player) then return true end
    
    if Settings.AdaptiveTeamCheck and KnownTeammates[player.Name] then
        return true
    end
    
    return false
end

-- =====================================================
-- === ИГНОР-ЛИСТ ===
-- =====================================================
local function IsIgnored(playerName)
    if not IgnoreListEnabled then return false end
    for _, name in ipairs(IgnoreList) do
        if name:lower() == playerName:lower() then
            return true
        end
    end
    return false
end

local function CanAttack(player)
    if player == LocalPlayer then return false end
    if IsIgnored(player.Name) then return false end
    if ManualEnemies[player.Name] then return true end
    if ManualTeammates[player.Name] then return false end
    if IsStandardTeammate(player) then return false end
    
    if Settings.AdaptiveTeamCheck and not IsTracked(player.Name) then
        return true
    end
    
    if IsTeammate(player) then return false end
    
    return true
end

local function IsWithinDistance(hrp)
    if not LocalPlayer.Character then return false end
    local myHrp = LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    if not myHrp then return false end
    
    local dist = (myHrp.Position - hrp.Position).Magnitude
    return dist <= Settings.MaxAimDistance
end

