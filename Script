local function RestartScript()
    print("[XENO] ===== ПЕРЕЗАПУСК =====")
    
    local savedSettings = {
        TriggerBot = Settings.TriggerBot,
        WallCheck = Settings.WallCheck,
        AimAssist = Settings.AimAssist,
        Smoothness = Settings.Smoothness,
        FOV = Settings.FOV,
        TriggerRadius = Settings.TriggerRadius,
        ShotDelay = Settings.ShotDelay,
    }
    local savedIgnoreList = {}
    for _, name in ipairs(IgnoreList) do
        table.insert(savedIgnoreList, name)
    end
    local savedIgnoreEnabled = IgnoreListEnabled
    
    StopLoop()
    GUI.CloseSettings()
    GUI.Destroy()
    GUI = CreateGUI()
    
    Settings.TriggerBot = savedSettings.TriggerBot
    Settings.WallCheck = savedSettings.WallCheck
    Settings.AimAssist = savedSettings.AimAssist
    Settings.Smoothness = savedSettings.Smoothness
    Settings.FOV = savedSettings.FOV
    Settings.TriggerRadius = savedSettings.TriggerRadius
    Settings.ShotDelay = savedSettings.ShotDelay
    
    IgnoreList = savedIgnoreList
    IgnoreListEnabled = savedIgnoreEnabled
    
    GUI.Update()
    StartLoop()
    
    print("[XENO] ✅ Перезапуск завершен!")
end

local function DeleteScript()
    print("[XENO] Скрипт удален")
    ScriptRunning = false
    StopLoop()
    GUI.Destroy()
end

-- ===== КЛАВИШИ =====
UserInputService.InputBegan:Connect(function(input)
    if not ScriptRunning then return end
    if input.KeyCode then
        if input.KeyCode == Enum.KeyCode.F1 then ToggleTrigger() end
        if input.KeyCode == Enum.KeyCode.F2 then ToggleWall() end
        if input.KeyCode == Enum.KeyCode.F3 then ToggleAim() end
        if input.KeyCode == Enum.KeyCode.F4 then ToggleSettings() end
        if input.KeyCode == Enum.KeyCode.F5 then RestartScript() end
        if input.KeyCode == Enum.KeyCode.F6 then ToggleIgnoreList() end
        if input.KeyCode == Enum.KeyCode.Delete then DeleteScript() end
    end
end)

